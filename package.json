{
  "name": "kadak-chai-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "test": "npm --prefix backend run test -- --runInBand",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start"
